testbench half_adder_tb {
    trace a;
    trace b;
    trace s;
    trace c;

    drive a = 0;
    drive b = 0;
    assert s == 0;
    assert c == 0;

    drive a = 0;
    drive b = 1;
    assert s == 1;
    assert c == 0;

    drive a = 1;
    drive b = 0;
    assert s == 1;
    assert c == 0;

    drive a = 1;
    drive b = 1;
    assert s == 0;
    assert c == 1;
}
